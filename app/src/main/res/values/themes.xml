<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.NanzBeatles" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="android:colorPrimaryDark">@android:color/black</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/black</item>
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- Background color -->
        <item name="android:colorBackground">@android:color/black</item>
        <!-- Window attributes -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.AuraMusic" parent="Theme.NanzBeatles" />
</resources>